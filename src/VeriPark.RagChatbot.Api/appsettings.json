{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "VeriPark.RagChatbot": "Information"
    }
  },
  "AllowedHosts": "localhost",

  "AzureOpenAI": {
    "Endpoint": "https://veri-chat-resource.services.ai.azure.com",
    "ApiKey": "xyz",
    "ChatDeployment": "gpt-4.1-mini-1",
    "EmbeddingDeployment": "text-embedding-3-small"
  },

  "Qdrant": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "UseHttps": false,
    "ApiKey": "",
    "CollectionName": "copilot_studio_licensing_guide"
  },

  "Rag": {
    "DocumentTitle": "Microsoft Copilot Studio Licensing Guide",
    "PdfPath": "data/Microsoft-Copilot-Studio-Licensing-Guide.pdf",
    "ChunkSize": 1200,
    "ChunkOverlap": 200,
    "EmbeddingBatchSize": 16,
    "TopK": 8,
    "MinRelevanceScore": 0.2,
    "MaxHistoryTurns": 20,
    "ConversationTimeoutMinutes": 120,
    "MaxQuestionLength": 2000,
    "ChatTemperature": 0.1
  }
}
